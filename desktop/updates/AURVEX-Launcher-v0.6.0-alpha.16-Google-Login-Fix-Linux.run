#!/usr/bin/env bash
set -Eeuo pipefail
if [[ "$(id -u)" == 0 ]]; then echo 'Do not run AURVEX Launcher as root.' >&2; exit 1; fi
if ! command -v node >/dev/null || ! command -v npm >/dev/null || ! command -v base64 >/dev/null; then echo 'Node.js 20+, npm, and base64 are required.' >&2; exit 1; fi
node_major="$(node -p 'Number(process.versions.node.split(".")[0])')"
if (( node_major < 20 )); then echo "Node.js 20 or newer is required; found $(node --version)." >&2; exit 1; fi
payload_line="$(awk '/^__AURVEX_PAYLOAD_BASE64_BELOW__$/ { print NR + 1; exit }' "$0")"
if [[ -z "$payload_line" ]]; then echo 'Package is damaged: source payload is missing.' >&2; exit 1; fi
install_root="${XDG_DATA_HOME:-$HOME/.local/share}/aurvex-launcher/0.6.0"
mkdir -p "$install_root"
tail -n +"$payload_line" "$0" | base64 -d | tar -xz --overwrite -C "$install_root"
source_root="$install_root/aurvex-desktop-alpha"
cd "$source_root/desktop"
echo 'Installing or refreshing AURVEX Launcher dependencies…'
npm install --no-fund --no-audit
echo 'Starting AURVEX Launcher v0.6.0-alpha.16…'
npm start
exit $?
